# Copia para .env e preenche. O .env nunca é commitado (ver .gitignore).
# Sem estas variáveis, o hub continua a correr com o MockPhcConnector
# (dados fictícios) — só são necessárias quando WINSIG_PHC_MODE=real.

# --- Modo do conector PHC ---
# "mock" (default, seguro) ou "real" (liga ao SQL Server real do PHC)
WINSIG_PHC_MODE=mock

# --- Ligação ao SQL Server do PHC (só relevante se WINSIG_PHC_MODE=real) ---
# Nome/IP da máquina onde o SQL Server corre. Se o PHC estiver noutro PC
# da rede (comum se este hub correr num Mac/Linux), usa o IP dessa máquina.
WINSIG_PHC_DB_HOST=localhost
# Só preencher UM de WINSIG_PHC_DB_PORT ou WINSIG_PHC_DB_INSTANCE:
WINSIG_PHC_DB_PORT=1433
# WINSIG_PHC_DB_INSTANCE=SQLEXPRESS
WINSIG_PHC_DB_NAME=NOME_DA_BASE_DE_DADOS_DO_PHC
# Recomendado: um login SQL dedicado com o mínimo de permissões
# necessário (ver README — "Ligar ao PHC real"), nunca sa/admin.
WINSIG_PHC_DB_USER=
WINSIG_PHC_DB_PASSWORD=

# Ligação cifrada (TLS) — manter "true".
WINSIG_PHC_DB_ENCRYPT=true
# Aceitar o certificado do servidor sem validação — necessário para um
# SQL Server local de teste com certificado autoassinado. Em produção,
# usar um certificado válido e deixar "false".
WINSIG_PHC_DB_TRUST_SERVER_CERT=true

# Interruptor de segurança para escritas reais (ex: criar encomenda).
# Mantém "false" até validares as queries de escrita contra uma
# cópia/backup da base de dados — nunca a produção viva à primeira vez.
WINSIG_PHC_ALLOW_WRITES=false

# --- Resto da configuração do hub (igual em modo mock ou real) ---
# WINSIG_MCP_API_KEY=            # obrigatória só no transporte stdio
# WINSIG_MCP_INTEGRATIONS_FILE=config/integrations.json
# WINSIG_MCP_AUDIT_LOG_FILE=logs/audit.log
# WINSIG_MCP_HTTP_PORT=3000
# WINSIG_MCP_HTTP_HOST=127.0.0.1
